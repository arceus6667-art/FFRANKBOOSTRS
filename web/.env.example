# Hosted Sites owns secure sign-in. Do not put these values in source control.
# Configure hosted runtime values with the Sites environment settings.
ADMIN_EMAIL=verified-owner@example.com
# Optional email/password provider. Leave unset to use secure hosted sign-in.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Secret 32+ character pepper for native password hashes. Keep stable.
AUTH_PEPPER=
# Temporary one-time administrator provisioning secret. Never commit a value.
ADMIN_BOOTSTRAP_TOKEN=
